APP_ENV=production
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-random-32-plus-character-secret
CORS_ORIGINS=https://your-admin.vercel.app,https://your-mobile-web-origin.example
SQL_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30
SENTRY_TRACES_SAMPLE_RATE=0.1
WEB_APP_BASE_URL=https://familypledgekenya.org
PUBLIC_API_BASE_URL=https://api.familypledgekenya.org/api/v1

# Safaricom Daraja / M-PESA — backend only. Never expose these values in Expo,
# Next.js, GitHub, or screenshots. Use sandbox credentials while testing, then
# replace with Safaricom-approved production credentials during Go Live.
MPESA_ENABLED=false
MPESA_ENV=sandbox
MPESA_BASE_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.familypledgekenya.org/api/v1/payments/mpesa/callback
# Current public payment account reference supplied for Family Pledge.
MPESA_ACCOUNT_REFERENCE=133133
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TRANSACTION_DESC=Family Pledge
MPESA_REQUEST_TIMEOUT_SECONDS=20
MPESA_PAYMENT_TTL_MINUTES=10
# Set explicitly before enabling M-PESA. This rate is locked into each payment.
MPESA_USD_KES_RATE=
MPESA_RECONCILIATION_ENABLED=false
MPESA_RECONCILIATION_INTERVAL_SECONDS=60
MPESA_RECONCILIATION_BATCH_SIZE=50
MPESA_QUERY_AFTER_SECONDS=30

# Text AI assistant
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-oss-120b

# Optional visual-language model for Admin AI image analysis.
AI_VISION_API_KEY=
AI_VISION_BASE_URL=
AI_VISION_MODEL=
AI_VISION_MAX_IMAGE_MB=5

AI_TASKS_WORKER_ENABLED=false
AI_TASKS_WORKER_INTERVAL_SECONDS=60

# Admin operations worker
OUTBOUND_WORKER_ENABLED=false
OUTBOUND_WORKER_INTERVAL_SECONDS=30
OUTBOUND_WORKER_BATCH_SIZE=250

# Native push: Expo Push Service. Android ultimately uses FCM; iOS uses APNs.
EXPO_ACCESS_TOKEN=

# Firebase is notification transport only. No Firebase Auth/Firestore/Storage.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=

# Consent-based email reminders / weekly emails
WEEKLY_EMAILS_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Family Pledge <admin@familypledgekenya.org>"
SMTP_USE_TLS=true

# Consent-based WhatsApp Business Cloud API reminders.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=family_pledge_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Cloudflare R2 public media bucket — backend secrets only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=family-pledge-media
R2_PUBLIC_BASE_URL=https://media.familypledgekenya.org
R2_MAX_UPLOAD_MB=500
R2_ALLOWED_UPLOADS_MODE=broad

# Legacy private contribution-proof bucket. New proof writes are retired; keep
# this configured only while historical proofs remain inside their retention window.
PROOF_R2_ACCOUNT_ID=
PROOF_R2_ACCESS_KEY_ID=
PROOF_R2_SECRET_ACCESS_KEY=
PROOF_R2_BUCKET_NAME=family-pledge-private-proofs
PROOF_RETENTION_DAYS=30
PROOF_SIGNED_GET_TTL_SECONDS=600

# Cloudflare Stream
STREAM_API_TOKEN=
STREAM_CUSTOMER_CODE=
STREAM_MAX_DURATION_SECONDS=21600
