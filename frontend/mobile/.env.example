# Public application runtime configuration only. Never place backend secrets here.
EXPO_PUBLIC_API_URL=https://api.familypledgekenya.org/api/v1

# EAS project used by Android/iOS Expo Push Tokens.
# `eas init` normally writes this ID into app config. It can also be supplied
# through EAS environment variables for preview/production builds.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Android FCM client configuration. In EAS, configure GOOGLE_SERVICES_JSON as a
# FILE environment variable that points to google-services.json. For local
# builds, a git-ignored ./google-services.json is also supported.
GOOGLE_SERVICES_JSON=

# Firebase Web App configuration for browser notifications only.
# These values identify the Firebase Web App and are public client configuration.
# Keep Firebase service-account credentials/private keys on the backend only.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
