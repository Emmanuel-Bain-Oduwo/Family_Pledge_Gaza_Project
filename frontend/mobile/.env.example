# Public application runtime configuration only. Never place backend secrets here.
EXPO_PUBLIC_API_URL=https://api.familypledgekenya.org/api/v1

# EAS project used by Android/iOS Expo Push Tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Firebase Web App configuration for browser notifications only.
# These values identify the Firebase Web App and are public client configuration.
# Keep Firebase service-account credentials/private keys on the backend only.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
