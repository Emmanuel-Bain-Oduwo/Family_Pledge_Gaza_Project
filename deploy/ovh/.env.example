# Family Pledge OVH backend deployment example
# Copy to deploy/ovh/.env on the OVH server. Never commit the real .env file.

# Reverse proxy / public API
API_DOMAIN=api.familypledgekenya.org

# PostgreSQL container
POSTGRES_DB=familypledge
POSTGRES_USER=familypledge
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Backend runtime
APP_ENV=production
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://familypledge:replace-with-a-strong-postgres-password@postgres:5432/familypledge
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=https://family-pledge-gaza-project.vercel.app,https://family-pledge-gaza-project-demo.vercel.app
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# First OVH deploy only: true. After migrations pass, set false and restart.
RUN_MIGRATIONS_ON_STARTUP=true
DEMO_SEED_ON_STARTUP=false

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# AI provider — OVH GPT-OSS-120B/OpenAI-compatible endpoint
# Keep the key and base URL backend-only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://replace-with-ovh-gpt-oss-120b-openai-compatible-base-url
OPENAI_MODEL=gpt-oss-120b

# Native push through Expo. Android ultimately uses FCM; iOS uses APNs.
EXPO_ACCESS_TOKEN=

# Firebase is used only for notification delivery (Web FCM + Android FCM credentials).
# Base64 encode the service-account JSON; never commit the JSON/private key.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
WEB_APP_BASE_URL=https://familypledgekenya.org

# Email
WEEKLY_EMAILS_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Family Pledge <admin@familypledgekenya.org>"

# Cloudflare R2 public media bucket — backend secrets only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=family-pledge-media
R2_PUBLIC_BASE_URL=https://media.familypledgekenya.org
R2_MAX_UPLOAD_MB=500
R2_ALLOWED_UPLOADS_MODE=broad

# Cloudflare R2 private contribution-proof bucket.
# Do NOT attach a public custom domain or enable r2.dev for this bucket.
# Prefer credentials scoped only to family-pledge-private-proofs.
PROOF_R2_ACCOUNT_ID=
PROOF_R2_ACCESS_KEY_ID=
PROOF_R2_SECRET_ACCESS_KEY=
PROOF_R2_BUCKET_NAME=family-pledge-private-proofs
PROOF_RETENTION_DAYS=30
PROOF_SIGNED_GET_TTL_SECONDS=600

# Cloudflare Stream — backend token only
STREAM_API_TOKEN=
STREAM_CUSTOMER_CODE=
STREAM_MAX_DURATION_SECONDS=21600

# Private database backup bucket — keep separate from public media and proof buckets.
AWS_DEFAULT_REGION=auto
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=family-pledge-backup-db
BACKUP_R2_PREFIX=db
BACKUP_KEEP_DAYS=7
